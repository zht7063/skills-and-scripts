# Copy to ./singbox-work/secrets.env  (chmod 600). NEVER commit the filled-in file.
# ---- Remote server (given by the user) ----
SERVER_IP=TODO_SERVER_IP
SSH_PORT=TODO_SSH_PORT
SSH_USER=root
# Key-based auth only. Path of the private key on THIS (local) machine.
# If the user only has a password, ask them to load a key / use ssh-agent; do not write passwords to files.
SSH_KEY=TODO_PATH_TO_PRIVATE_KEY

# ---- Layout / ports (defaults come from the recorded deployment) ----
INSTALL_DIR=/opt/sing-box
SS_PORT=8388
SS_METHOD=2022-blake3-aes-128-gcm
VLESS_PORT=8443
VLESS_FLOW=xtls-rprx-vision
LOG_LEVEL=info

# ---- REALITY camouflage target (MUST be decided with the user; see singbox-config-generate) ----
REALITY_SNI=TODO_REALITY_SNI

# ---- Generated by singbox-config-generate/scripts/gen-secrets.sh (leave TODO until then) ----
SS_PASSWORD=TODO
VLESS_UUID=TODO
REALITY_PRIVATE_KEY=TODO
REALITY_PUBLIC_KEY=TODO
SHORT_ID=TODO

# ---- Local test client ----
LOCAL_MIXED_PORT=7890
LOCAL_CONTROLLER_PORT=9090
