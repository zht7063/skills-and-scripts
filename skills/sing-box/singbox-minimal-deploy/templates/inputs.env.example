# Copy to ./singbox-work/secrets.env  (chmod 600). NEVER commit the filled-in file.
# ---- Remote server (given by the user) ----
SERVER_IP=TODO_SERVER_IP
SSH_PORT=TODO_SSH_PORT
SSH_USER=root
# Key-based auth only. Path of the private key on THIS (local) machine.
# If the user only has a password, ask them to load a key / use ssh-agent; do not write passwords to files.
SSH_KEY=TODO_PATH_TO_PRIVATE_KEY

# ---- Layout / ports (defaults come from the recorded deployment) ----
# Server directory: FIXED. ALL sing-box files on the server (config.json, compose.yaml, env, keys, backups ...) live here.
REMOTE_DIR=/opt/sing-box
SS_PORT=8388
SS_METHOD=2022-blake3-aes-128-gcm
VLESS_PORT=8443
# Fresh deploy: ONE variable rendered into BOTH server config.json and the client profiles (always matches).
# Existing server: overwritten with the server's actual flow (empty `VLESS_FLOW=` if it has no flow field).
VLESS_FLOW=xtls-rprx-vision
LOG_LEVEL=info

# ---- REALITY camouflage target (decided by the user) ----
# Default www.microsoft.com. Fallback order ONLY if real testing fails (handshake error/timeouts):
#   www.intel.com -> www.nvidia.com   (procedure: singbox-reality-perf-troubleshoot, "SNI fallback procedure")
# The same value is used for server tls.server_name, server reality.handshake.server (port 443) and client servername.
REALITY_SNI=www.microsoft.com

# ---- Generated (leave TODO until then) ----
# SS_PASSWORD: singbox-minimal-deploy/scripts/gen-secrets.sh
# the other four: singbox-reality-perf-troubleshoot/scripts/gen-reality-secrets.sh (only needed once VLESS-REALITY is added)
SS_PASSWORD=TODO
VLESS_UUID=TODO
REALITY_PRIVATE_KEY=TODO
REALITY_PUBLIC_KEY=TODO
SHORT_ID=TODO

# ---- Local test client ----
LOCAL_MIXED_PORT=7890
LOCAL_CONTROLLER_PORT=9090
